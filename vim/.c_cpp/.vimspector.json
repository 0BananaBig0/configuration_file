{
    "configurations": {
        "cpp: launch": {
            "adapter": "vscode-cpptools",
            "configuration": {
                "name": "cpp: launch",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceRoot}/",
                "args": [
                    "",
                    "",
                    ""
                ],
                "cwd": "${workspaceRoot}",
                "stopAtEntry": true,
                "environment": [],
                "externalConsole": true,
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            "breakpoints": {
                "exception": {
                    "all": "Y"
                }
            }
        },
        "python: project": {
            "adapter": "debugpy",
            "filetypes": [
                "python"
            ],
            "configuration": {
                "name": "python: project",
                "type": "python",
                "request": "launch",
                "module": "",
                "enable_project_debug": true,
                "args": [
                    "",
                    "",
                    ""
                ],
                "console": "externalTerminal",
                "cwd": "${workspaceRoot}",
                "stopOnEntry": true,
                "debugOptions": [],
                "env": {
                    "var_example": "value_example"
                }
            },
            "breakpoints": {
                "exception": {
                    "raised": "Y",
                    "uncaught": "Y",
                    "userUnhandled": "Y"
                }
            }
        },
        "python: single-file": {
            "adapter": "debugpy",
            "filetypes": [
                "python"
            ],
            "configuration": {
                "name": "python: single-file",
                "type": "python",
                "request": "launch",
                "program": "${file}",
                "args": [
                    "",
                    "",
                    ""
                ],
                "console": "externalTerminal",
                "cwd": "${workspaceRoot}",
                "stopOnEntry": true,
                "debugOptions": [],
                "env": {
                    "var_example": "value_example"
                }
            },
            "breakpoints": {
                "exception": {
                    "raised": "Y",
                    "uncaught": "Y",
                    "userUnhandled": "Y"
                }
            }
        },
        "tcl: launch": {
            "adapter": "tclpro",
            "variables": {
                "args": "Useless args"
            },
            "configuration": {
                "request": "launch",
                "tclsh": "/usr/bin/tclsh",
                "cwd": "${workspaceRoot}",
                "target": "${file}",
                "args": [
                    "",
                    "",
                    ""
                ]
            }
        }
    }
}
