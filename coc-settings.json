{
    "languageserver": {
        "assembly": {
            "command": "asm-lsp",
            "filetypes": [
                "asm"
            ]
        },
        "qml": {
            "command": "qmlls",
            "filetypes": [
                "qml"
            ]
        },
        "svlangserver": {
            "command": "svlangserver",
            "filetypes": [
                "systemverilog",
                "vhdl",
                "verilog"
            ],
            "settings": {
                "systemverilog.includeIndexing": [
                    "**/*.{v,sv,svh}"
                ],
                "systemverilog.excludeIndexing": [],
                "systemverilog.launchConfiguration": "verilator --lint-only --language 1364-2005",
                "systemverilog.formatCommand": "verible-verilog-format --column_limit=80 --indentation_spaces=4 --wrap_spaces=4"
            }
        }
    },
    "workspace.rootPatterns": [
        ".git",
        ".hg",
        ".projections.json",
        ".project",
        ".svn",
        ".root",
        ".vscode",
        "SConstruct"
    ],
    "clangd.arguments": [
        "--all-scopes-completion",
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--fallback-style=none",
        "--function-arg-placeholders=1",
        "--header-insertion=never",
        "--header-insertion-decorators",
        "--enable-config",
        "--j=12",
        "--pch-storage=memory",
        "--pretty"
    ],
    "dialog.floatHighlight": "sym_hilight",
    "diagnostic.enable": false,
    "diagnostic.errorSign": "🌪",
    "diagnostic.hintSign": "💡",
    "diagnostic.infoSign": "📄",
    "diagnostic.messageTarget": "echo",
    "diagnostic.virtualText": true,
    "diagnostic.warningSign": "⚡",
    "inlayHint.enable": true,
    "markdownlint.config": {
        "MD013": {
            "line_length": 100
        },
        "ignore_code_blocks": true
    },
    "perl.enable": true,
    "perl.logLevel": 2,
    "perl.logFile": "${HOME}/.vim/.coc-perl.log",
    "prettier.formatterPriority": -1,
    "prettier.printWidth": 80,
    "prettier.proseWrap": "always",
    "prettier.disableLanguages": [
        "json"
    ],
    "json.format.enable": true,
    "python.formatting.provider": "black",
    "signature.target": "echo",
    "suggest.autoTrigger": "none",
    "suggest.defaultSortMethod": "alphabetical",
    "suggest.detailField": "preview",
    "suggest.maxCompleteItemCount": 18,
    "suggest.noselect": true,
    "suggest.selection": "recentlyUsedByPrefix",
    "suggest.virtualText": true,
    "suggest.triggerAfterInsertEnter": true,
    "suggest.localityBonus": true,
    "suggest.languageSourcePriority": 99,
    "suggest.removeDuplicateItems": true,
    "suggest.highPrioritySourceLimit": 50,
    "suggest.lowPrioritySourceLimit": 20
    "coc.source.snippets.priority": 95,
    "coc.source.snippets.shortcut": "S",
    "coc.source.around.priority": 80,
    "coc.source.around.shortcut": "A",
    "coc.source.buffer.priority": 70,
    "coc.source.buffer.shortcut": "B",
    "coc.source.file.priority": 60,
    "coc.source.file.shortcut": "F",
    "coc.source.dictionary.priority": 50,
    "coc.source.dictionary.shortcut": "D",
    "coc.source.tag.priority": 40,
    "coc.source.tag.shortcut": "T",
    "coc.source.word.priority": 30,
    "coc.source.word.shortcut": "W",
}
